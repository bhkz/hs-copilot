<Window x:Class="HsCopilot.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Copilot — Conseil"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Text}">
  <Window.Resources>
    <Style x:Key="Small" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,7,0,1" />
    </Style>
    <Style x:Key="Line" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="Bool2Vis" />
  </Window.Resources>

  <Border x:Name="Frame" CornerRadius="10" Padding="12,8,12,10" BorderThickness="1" BorderBrush="#4A5466">
    <Border.Background>
      <SolidColorBrush Color="#16181D" Opacity="0.94" />
    </Border.Background>
    <StackPanel>
      <!-- En-tête : glisser pour déplacer -->
      <DockPanel x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Small}" Content="⟳" ToolTip="Réanalyser maintenant (Ctrl+Alt+R)" Click="Reanalyze_Click" />
          <Button Style="{StaticResource Small}" Content="{Binding PauseGlyph}" ToolTip="Pause / reprise des analyses automatiques (Ctrl+Alt+P)" Click="Pause_Click" />
          <Button Style="{StaticResource Small}" Content="▭" ToolTip="Mode compact" Click="Compact_Click" />
          <Button Style="{StaticResource Small}" Content="✕" ToolTip="Masquer (Ctrl+Alt+H pour réafficher)" Click="Hide_Click" />
        </StackPanel>
        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,7,0" />
        <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- Létal -->
      <Border Background="#3A2A12" CornerRadius="5" Padding="7,4" Margin="0,7,0,0" Visibility="{Binding HasLethal, Converter={StaticResource Bool2Vis}}">
        <TextBlock Text="{Binding LethalText}" Foreground="{Binding LethalColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>

      <!-- Action immédiate -->
      <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource Label}" />
      <TextBlock Text="{Binding ActionText}" Style="{StaticResource Line}" FontSize="15.5" FontWeight="SemiBold" Foreground="{Binding ActionColor}" />
      <TextBlock Text="{Binding VerifiedText}" Style="{StaticResource Line}" FontSize="10.5" Foreground="{Binding VerifiedColor}" Margin="0,1,0,0" />
      <TextBlock Text="{Binding CautionText}" Style="{StaticResource Line}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,4,0,0" />

      <StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource Bool2Vis}}">
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Line}" Margin="0,4,0,0" />

        <TextBlock Text="PLAN" Style="{StaticResource Label}" Visibility="{Binding HasPlan, Converter={StaticResource Bool2Vis}}" />
        <TextBlock Text="{Binding PlanText}" Style="{StaticResource Line}" />

        <TextBlock Text="POURQUOI" Style="{StaticResource Label}" Visibility="{Binding HasWhy, Converter={StaticResource Bool2Vis}}" />
        <TextBlock Text="{Binding WhyText}" Style="{StaticResource Line}" />

        <TextBlock Text="ENSUITE (NON VÉRIFIÉ)" Style="{StaticResource Label}" Visibility="{Binding HasNext, Converter={StaticResource Bool2Vis}}" />
        <TextBlock Text="{Binding NextText}" Style="{StaticResource Line}" Foreground="{StaticResource Muted}" />

        <TextBlock Text="{Binding FactsText}" Style="{StaticResource Line}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Line}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,8,0,0" />
      <TextBlock Text="{Binding FooterText}" Style="{StaticResource Line}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"
                 Visibility="{Binding ShowDetails, Converter={StaticResource Bool2Vis}}" />
    </StackPanel>
  </Border>
</Window>
