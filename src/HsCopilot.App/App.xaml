<Application x:Class="HsCopilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#16181D" />
    <SolidColorBrush x:Key="Panel" Color="#1F232B" />
    <SolidColorBrush x:Key="PanelAlt" Color="#262B35" />
    <SolidColorBrush x:Key="Border" Color="#323947" />
    <SolidColorBrush x:Key="Text" Color="#E6E9EF" />
    <SolidColorBrush x:Key="Muted" Color="#9AA3B2" />
    <SolidColorBrush x:Key="Accent" Color="#E2B65B" />
    <SolidColorBrush x:Key="Good" Color="#6CC487" />
    <SolidColorBrush x:Key="Warn" Color="#E8B04B" />
    <SolidColorBrush x:Key="Bad" Color="#E26D6D" />

    <!-- Pas de style TextBlock implicite ici : au niveau Application, il s'appliquerait aussi
         aux TextBlock internes des ComboBox et onglets (texte clair sur fond clair). -->
    <Style x:Key="Optional" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Optional}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PanelAlt}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1E1E1E" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#202020" />
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelAlt}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
  </Application.Resources>
</Application>
