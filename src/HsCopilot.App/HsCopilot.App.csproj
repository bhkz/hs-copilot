<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>HsCopilot.App</AssemblyName>
    <RootNamespace>HsCopilot.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HsCopilot.Core\HsCopilot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Repères stratégiques transmis au modèle : copiés à côté de l'exécutable pour être trouvés d'où qu'on lance. -->
    <None Include="..\..\config\strategy\*.md" Link="config\strategy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
