<Window x:Class="HsCopilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Copilot — Diagnostic"
        Width="1320" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="12.5"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <DataTemplate x:Key="LineTemplate">
      <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" Margin="0,1" />
    </DataTemplate>

    <DataTemplate x:Key="PlayerTemplate">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" />
          <TextBlock Text="{Binding HeroLine}" FontSize="13.5" Margin="0,3,0,0" />
          <TextBlock Text="{Binding ManaLine}" Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding EquipmentLine}" Style="{StaticResource MutedText}" />

          <TextBlock Text="Plateau" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding BoardEmpty}" Style="{StaticResource MutedText}" />
          <ItemsControl ItemsSource="{Binding Board}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Width="170" ToolTip="{Binding Tooltip}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Stats}" FontSize="14" />
                    <TextBlock Text="{Binding Keywords}" Style="{StaticResource Optional}" Foreground="{StaticResource Accent}" FontSize="11" />
                    <TextBlock Text="{Binding Enchantments}" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Optional}" Foreground="{Binding StateColor}" FontSize="11" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding HandTitle}" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Hand}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1.5" ToolTip="{Binding Tooltip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#2B4370" CornerRadius="10" Width="24" Height="20" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Cost}" Foreground="{Binding CostColor}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding DeckLine}" Style="{StaticResource Optional}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding DeckDetails}" Style="{StaticResource MutedText}" FontSize="11.5" />
          <TextBlock Text="{Binding ExtraLine}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
          <TextBlock Text="{Binding LastTurnLine}" Style="{StaticResource MutedText}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="ListBoxPlain" TargetType="ItemsControl">
      <Setter Property="Margin" Value="10" />
      <Setter Property="ItemTemplate" Value="{StaticResource LineTemplate}" />
    </Style>
    <Style x:Key="CodeBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- En-tête -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="12,8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="GameCombo" Visibility="Collapsed" SelectionChanged="GameCombo_SelectionChanged" MinWidth="170" />
          <Button x:Name="PrevButton" Content="◀" Visibility="Collapsed" Click="Prev_Click" ToolTip="Point précédent" />
          <ComboBox x:Name="PointCombo" Visibility="Collapsed" SelectionChanged="PointCombo_SelectionChanged" MinWidth="250" />
          <Button x:Name="NextButton" Content="▶" Visibility="Collapsed" Click="Next_Click" ToolTip="Point suivant" />
          <Button Content="Ouvrir un replay…" Click="OpenReplay_Click" Margin="12,0,0,0" />
          <Button x:Name="LiveButton" Content="Revenir au direct" Visibility="Collapsed" Click="Live_Click" />
          <Button Content="Copier le GameState" Click="CopyJson_Click" />
          <Button Content="Banc d'essai…" Click="Bench_Click" ToolTip="Examiner les décisions d'un banc d'essai du conseiller (MVP 3A)" />
        </StackPanel>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceColor}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}" Margin="14,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding GameText}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
          <TextBlock Margin="0,1,0,0">
            <Run Text="{Binding TurnText, Mode=OneWay}" />
            <Run Text="  ·  " Foreground="{StaticResource Muted}" />
            <Run Text="{Binding RevisionText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bandeau état incomplet -->
    <Border DockPanel.Dock="Top" Background="#4A1F24" Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IncompleteText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding IncompleteText}" Foreground="#FFD7D7" FontWeight="SemiBold" />
    </Border>

    <!-- Pied de page -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="12,4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Footer}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </Border>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Flags}" ItemTemplate="{StaticResource LineTemplate}" Margin="2,0,0,8" />
          <ContentControl Content="{Binding Opponent}" ContentTemplate="{StaticResource PlayerTemplate}" />
          <ContentControl Content="{Binding Local}" ContentTemplate="{StaticResource PlayerTemplate}" />
        </StackPanel>
      </ScrollViewer>

      <TabControl Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}">
        <TabItem Header="Conseiller" x:Name="AdvisorTab">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" TextElement.Foreground="{StaticResource Text}">
              <TextBlock Text="Fournisseur OpenAI" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding KeyText}" Foreground="{Binding KeyColor}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Tester la connexion" Click="Ping_Click" Margin="0" />
                <TextBlock Text="{Binding PingText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>

              <TextBlock Text="Réglages" Style="{StaticResource SectionTitle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Modèle" VerticalAlignment="Center" Margin="0,3,10,3" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelCombo" IsEditable="True" HorizontalAlignment="Left" MinWidth="200" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Effort de raisonnement" VerticalAlignment="Center" Margin="0,3,10,3" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EffortCombo" HorizontalAlignment="Left" MinWidth="120" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Analyses automatiques par tour" VerticalAlignment="Center" Margin="0,3,10,3" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CallsBox" Width="60" HorizontalAlignment="Left" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="Budget maximal par partie ($)" VerticalAlignment="Center" Margin="0,3,10,3" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="GameBudgetBox" Width="60" HorizontalAlignment="Left" Margin="0,3" />
                <TextBlock Grid.Row="4" Text="Budget maximal par session ($)" VerticalAlignment="Center" Margin="0,3,10,3" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SessionBudgetBox" Width="60" HorizontalAlignment="Left" Margin="0,3" />
                <TextBlock Grid.Row="5" Text="Délai maximal d'une analyse (s)" VerticalAlignment="Center" Margin="0,3,10,3" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TimeoutBox" Width="60" HorizontalAlignment="Left" Margin="0,3" />
              </Grid>
              <CheckBox x:Name="EnabledCheck" Content="Conseiller activé" Foreground="{StaticResource Text}" Margin="0,6,0,0" />
              <CheckBox x:Name="StreamCheck" Content="Afficher l'action dès qu'elle arrive (réponse en flux)" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
              <CheckBox x:Name="ChoicesCheck" Content="Conseiller aussi le mulligan, les Découvertes et les Rembobinages" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
              <CheckBox x:Name="RankedCheck" Content="Conseiller aussi en partie classée" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
              <TextBlock Style="{StaticResource MutedText}" Margin="20,2,0,0"
                         Text="Une aide en temps réel en classé va au-delà d'un deck tracker : Blizzard ne l'autorise pas explicitement (voir docs/CONFORMITE.md). À activer en connaissance de cause." />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Enregistrer et appliquer" Click="SaveAdvisor_Click" Margin="0" />
                <TextBlock x:Name="SaveText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>
              <TextBlock Text="{Binding EffectiveText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

              <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}" />
              <WrapPanel>
                <Button Content="Afficher / masquer" Click="ToggleOverlay_Click" Margin="0,0,4,4" />
                <Button Content="Mode compact" Click="ToggleCompact_Click" Margin="0,0,4,4" />
                <Button Content="Pause / reprise" Click="TogglePause_Click" Margin="0,0,4,4" />
                <Button Content="Réanalyser maintenant" Click="Reanalyze_Click" Margin="0,0,4,4" />
              </WrapPanel>
              <TextBlock Text="{Binding HotkeysText}" Style="{StaticResource MutedText}" />

              <TextBlock Text="État" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding PhaseText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding StatsText}" Style="{StaticResource MutedText}" />
              <TextBlock Text="Dernier conseil (détail)" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
              <TextBlock Text="Journal du conseiller" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding Journal}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Actions légales">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}" Style="{StaticResource ListBoxPlain}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Historique">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding History}" Style="{StaticResource ListBoxPlain}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Validation">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Ouvrir le dossier des rapports" Click="OpenReports_Click" HorizontalAlignment="Left" Margin="10,0,10,10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Validation}" Style="{StaticResource ListBoxPlain}" />
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Contrôle HDT">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Check}" Style="{StaticResource ListBoxPlain}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Texte">
          <TextBox Text="{Binding StateText, Mode=OneWay}" Style="{StaticResource CodeBox}" />
        </TabItem>
        <TabItem Header="GameState (JSON)">
          <TextBox Text="{Binding Json, Mode=OneWay}" Style="{StaticResource CodeBox}" />
        </TabItem>
        <TabItem Header="Journal">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Log}" Margin="10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
