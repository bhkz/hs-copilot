{
  // Copier ce fichier vers %LocalAppData%\HsCopilot\copilot.json (ou passer --config <chemin>).
  // Les commentaires et virgules finales sont acceptés.

  // BattleTag du joueur local. Facultatif : le joueur local est déduit du log
  // (options légales reçues, choix envoyés). Le renseigner ajoute une confirmation.
  "localPlayerName": null,

  // Dossier Logs de Hearthstone (un sous-dossier Hearthstone_AAAA_MM_JJ_... par session).
  "hearthstoneLogsDir": "C:\\Program Files (x86)\\Hearthstone\\Logs",

  // Base de cartes. Vide : CardDefs téléchargés par HDT (%AppData%\HearthstoneDeckTracker\CardDefs),
  // mis en cache par build dans %LocalAppData%\HsCopilot\carddb. Sinon : chemin d'un cards.json HearthstoneJSON.
  "cardDbPath": null,

  // Source des événements : "auto" (plugin HDT, sinon lecture directe du Power.log), "hdt", "log", "none".
  "source": "auto",
  "autoFallbackSeconds": 5,

  // Journal brut des lignes reçues (une copie par partie), utile pour rejouer un problème.
  "journalEnabled": true,
  "journalDir": null,

  // Deck utilisé quand HDT ne fournit pas le deck actif (lecture directe du log ou rejeu).
